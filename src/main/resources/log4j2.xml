<?xml version="1.0" encoding="UTF-8"?>
<Configuration status="WARN">

    <Appenders>
        <Console name="Console" target="SYSTEM_OUT">
            <PatternLayout pattern="%d{yyyy-MM-dd HH:mm:ss} %-5level %logger{1.} - %msg%n"/>
        </Console>
    </Appenders>

    <Loggers>
    	<!-- My application: default DEBUG -->
        <Logger name="malecluk.garminparser" level="INFO"/>
        
        <!-- Selected classes in application to allow debug only where needed -->
        <Logger name="malecluk.garminparser.fileparser.listeners.MyMesgListener" level="INFO"/>
        
        <!-- Spring Boot entry point: only INFO -->
        <Logger name="malecluk.garminparser.FitApplication" level="INFO"/>
        
        <!-- Rest of all, including Spring: INFO -->
        <Root level="INFO">
            <AppenderRef ref="Console"/>
        </Root>
    </Loggers>

</Configuration>